          <datasource-dependencies datasource='federated.1w646yx1u5i3jq17nvnns1niboqa'>
            <column caption='Session Start Price' datatype='real' name='[Calculation_5949709431869440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [name]:SUM(IF [timestamp]={FIXED :MIN([timestamp])}THEN [quote_USD_price]END)}' />
